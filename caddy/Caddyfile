# Header di sicurezza comuni ai due siti
(sicurezza) {
	header {
		Strict-Transport-Security "max-age=31536000"   # il browser userà solo HTTPS per un anno
		X-Content-Type-Options "nosniff"                # niente "indovinare" il tipo dei file
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server                                         # non dire che software gira
	}
}

# Il sito: tutto al frontend (nginx passa /api al backend)
{$DOMINIO} {
	import sicurezza
	header {
		# chi può mostrare il sito in un iframe: solo il sito stesso
		# ('self' e non 'none': il login silenzioso di Keycloak usa un iframe della stessa origine)
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
	}
	encode zstd gzip
	reverse_proxy frontend:80
}

# Keycloak su un sottodominio
auth.{$DOMINIO} {
	import sicurezza

	# Console di amministrazione e realm master: NON raggiungibili da Internet.
	# Si usano solo dal tunnel SSH (vedi docker-compose.prod.yml).
	@amministrazione path /admin /admin/* /realms/master /realms/master/*
	respond @amministrazione 404

	reverse_proxy keycloak:8080
}

# torneopro18: un'altra app sullo stesso server, con i suoi container (repo Giugo18/torneopro18, deploy/).
# Caddy la raggiunge solo dalla rete torneopro-proxy, dove c'è soltanto il suo frontend: torneopro18 non vede
# i servizi di docai (Postgres, Keycloak, Ollama) e docai non vede i suoi.
# CSP e noindex li manda l'nginx di torneopro18; qui gli header comuni e l'HTTPS.
torneopro.mendoza18surco.it {
	import sicurezza
	encode zstd gzip
	reverse_proxy torneopro-frontend:8080
}

# test-evelin: WordPress di prova (repo Giugo18/test_evelin, deploy/), staging privato.
# Caddy la raggiunge solo dalla rete evelin-proxy, dove c'è soltanto il suo nginx.
# Password (basic auth) e noindex li gestisce l'nginx di test-evelin; qui gli header comuni e l'HTTPS.
test-evelin.mendoza18surco.it {
	import sicurezza
	encode zstd gzip
	reverse_proxy evelin-nginx:8080
}
